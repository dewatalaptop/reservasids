rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Data master untuk form publik: baca bebas, tulis hanya admin.
    match /locations/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /menus/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /date_status/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Data tamu (nama, nomor HP, menu, DP). Halaman tamu reservasi.html membaca SATU dokumen berdasarkan ID acak (get);
    // daftar/pencarian hanya untuk admin dan papan staf yang login. Ketersediaan publik lewat fungsi publicAvailability.
    match /reservations/{doc} {
      allow get: if true;
      allow list: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Riwayat perubahan (siapa mengubah apa): admin yang login boleh menambah dan membaca; tidak boleh diubah atau dihapus.
    match /audit_log/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Permintaan tamu: dibuat HANYA oleh fungsi submitReservation (Admin SDK, mengabaikan aturan ini).
    // Sebelumnya `allow write: if true` -- siapa pun bisa membuat, mengubah, atau menghapus permintaan tamu.
    match /reservation_requests/{doc} {
      allow read: if request.auth != null;
      allow create: if false;
      allow update, delete: if request.auth != null;
    }
  }
}
